# systemd service: keeps the Streamlit app running in the background, restarts it if it crashes,
# and starts it again after a reboot. Installed by scripts/deploy-app.sh, which fills in
# __USER__ and __REPO_DIR__.

[Unit]
Description=STADVDB MCO2 Streamlit webapp
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
User=__USER__
WorkingDirectory=__REPO_DIR__
ExecStart=__REPO_DIR__/.venv/bin/streamlit run app.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
